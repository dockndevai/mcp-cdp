# --- DevTools endpoint -------------------------------------------------------
# The --remote-debugging-port your Electron app or Chrome/Chromium exposes.
CDP_PORT=9222
# Host serving the endpoint. Must be loopback unless CDP_ALLOW_REMOTE=true.
CDP_HOST=127.0.0.1
# Allow a non-loopback host. DANGEROUS: a remote debugging port lets anything that reaches it drive
# the browser. Leave false unless you understand the exposure.
CDP_ALLOW_REMOTE=false

# --- Connection --------------------------------------------------------------
CDP_TIMEOUT_MS=30000
# Max items returned by list/console/network tools (1-1000).
CDP_MAX_RESULTS=100
# Ring-buffer size for console/network events captured per attached target (50-5000).
CDP_MAX_BUFFER=500

# --- Security ----------------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  -> list_targets, dom_snapshot, query_dom, console_logs, network_requests, screenshot
#   read-write -> adds click, type_text, press_key, navigate
#   admin      -> adds evaluate (needs CDP_ALLOW_EVAL=true)
CDP_MODE=read-only
# Comma-separated URL patterns interactions are confined to. Empty = all. A pattern is a
# case-insensitive substring, or use a leading/trailing * as a wildcard, e.g. https://app.local*
CDP_TARGET_ALLOWLIST=
# Comma-separated URL patterns that may be inspected but never interacted with. Empty = built-in
# defaults (chrome://*, devtools://*, chrome-extension://*, about:*, and common sign-in origins).
CDP_PROTECTED_TARGETS=
# Running arbitrary JavaScript (the evaluate tool) requires this in addition to admin mode.
CDP_ALLOW_EVAL=false
# Log interactions (click/type/navigate/evaluate) without dispatching them to the browser.
CDP_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
CDP_AUDIT_LOG=true
