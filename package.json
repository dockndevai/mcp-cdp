{
  "name": "@dockndevai/mcp-cdp",
  "mcpName": "io.github.dockndevai/mcp-cdp",
  "version": "0.2.0",
  "description": "Model Context Protocol server that drives an Electron/Chrome app over the DevTools Protocol (CDP) — DOM, console, network, click/type/navigate and gated JS eval — safe by default, cross-OS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockndevai/mcp-cdp.git"
  },
  "bugs": {
    "url": "https://github.com/dockndevai/mcp-cdp/issues"
  },
  "homepage": "https://dockndevai.github.io/",
  "bin": {
    "mcp-cdp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cdp",
    "chrome-devtools-protocol",
    "electron",
    "chrome",
    "browser-automation",
    "devtools",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
